{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gryphus",
  "version": "0.1.0",
  "identifier": "dev.gryphus.app",
  "build": {
    "beforeDevCommand": "trunk --config ui/Trunk.toml serve",
    "beforeBuildCommand": "trunk --config ui/Trunk.toml build --release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gryphus",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
